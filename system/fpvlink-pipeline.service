[Unit]
Description=FPVLink Always-On Video Pipeline
Documentation=https://github.com/yourorg/fpvlink
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fpvlink
Group=fpvlink
WorkingDirectory=/opt/fpvlink

# Ensure the socket directory exists and has correct permissions
ExecStartPre=+/usr/bin/mkdir -p /run/fpvlink
ExecStartPre=+/bin/chown -R fpvlink:fpvlink /run/fpvlink

# Cold-boot HDMI race: the kernel force-enables the HDMI connector (cmdline
# video=HDMI-A-1:...@60e, no real EDID/hotplug) around when systemd starts us,
# and the CRTC often isn't scanning yet when our first modeset lands -> black
# screen. This short delay alone does NOT fix it (verified black even at t~16s);
# the actual fix is the one-shot warm-restart in capture/pipeline.py (see
# WARM_MARKER). The delay just gives that first warm run a stable start point.
ExecStartPre=/bin/sleep 5

# Run the always-on pipeline script
ExecStart=/usr/bin/python3 capture/pipeline.py

# Always restart if it crashes
Restart=always
RestartSec=3

# Environment
Environment=NODE_ENV=production
Environment=FPVLINK_CONFIG=/opt/fpvlink/system/config.json

# Process control
LimitNOFILE=65535
OOMScoreAdjust=-500
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
