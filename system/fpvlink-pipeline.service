[Unit]
Description=FPVLink Always-On Video Pipeline
Documentation=https://github.com/Drone-David/fpvlink
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fpvlink
Group=fpvlink
WorkingDirectory=/opt/fpvlink

# Ensure the socket directory exists and has correct permissions
ExecStartPre=+/usr/bin/mkdir -p /run/fpvlink
ExecStartPre=+/bin/chown -R fpvlink:fpvlink /run/fpvlink

# Cold-boot HDMI black-screen fix lives in capture/pipeline.py (one-shot
# warm-restart; see WARM_MARKER). The settle/warm delays are now inside that
# script and gated to the warm run only, so we no longer delay here (the old
# ExecStartPre sleep was paid on both the warm and the real start).

# Run the always-on pipeline script
ExecStart=/usr/bin/python3 capture/pipeline.py

# Always restart if it crashes. RestartSec is short because the cold-boot
# warm-restart (see capture/pipeline.py) relies on this gap being brief.
Restart=always
RestartSec=1

# Environment
Environment=NODE_ENV=production
Environment=FPVLINK_CONFIG=/opt/fpvlink/system/config.json

# Process control
LimitNOFILE=65535
OOMScoreAdjust=-500
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
