# ─────────────────────────────────────────────────────────────────────────────
# /opt/fpvlink/system/fpvlink.env
#
# FPVLink environment variable template.
#
# !! SECURITY NOTICE !!
#   This file may contain stream keys and sensitive credentials.
#   - File permissions must be 640 (owner: root, group: fpvlink):
#       sudo chown root:fpvlink /opt/fpvlink/system/fpvlink.env
#       sudo chmod 640          /opt/fpvlink/system/fpvlink.env
#   - Do NOT commit this file to git with real values — use .gitignore.
#   - Use the .env.example file (no real values) for version control instead.
#
# Loaded by the systemd unit via:
#   EnvironmentFile=/opt/fpvlink/system/fpvlink.env
#
# Key=value format. Shell variable expansion ($VAR) is NOT supported here.
# Lines starting with # are comments. Blank lines are ignored.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Streaming destinations ───────────────────────────────────────────────────

# YouTube Live stream key.
# Found in YouTube Studio → Go Live → Stream Settings → Stream key.
# Example: xxxx-xxxx-xxxx-xxxx-xxxx
STREAM_KEY_YOUTUBE=

# Twitch stream key.
# Found in Twitch Dashboard → Settings → Stream → Primary stream key.
# Example: live_123456789_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STREAM_KEY_TWITCH=

# Custom SRT destination URI. Overrides config.json outputs.srt.url.
# Format: srt://host:port  (caller mode — FPVLink connects out)
#    OR:  srt://:port       (listener mode — remote connects in)
# Leave blank to use the value from config.json.
SRT_URL=

# Custom RTMP destination URI. Overrides config.json outputs.rtmp.url.
# Do NOT include the stream key here — use STREAM_KEY_YOUTUBE or
# STREAM_KEY_TWITCH above, or append it in config.json.
# Example: rtmp://a.rtmp.youtube.com/live2
# Example: rtmp://live.twitch.tv/app
RTMP_URL=


# ─── Web server ───────────────────────────────────────────────────────────────

# TCP port for the embedded web UI and REST API.
# Overrides config.json web.port.
# Default: 8080. Use 80 for standard HTTP (requires CAP_NET_BIND_SERVICE or root).
FPVLINK_PORT=8080

# Dashboard password. Standard across every FPVLink box.
#
#   fpvlink12345
#
# Deliberately the same on every unit: a rack of boxes with per-unit passwords
# is unusable at an event, and an operator should be able to walk up to any box
# and get in. Keeping it here rather than generating one per box is the whole
# point.
#
# BUT KNOW WHAT IT IS AND IS NOT. This value is published in the FPVLink repo,
# so it is not a secret from anyone who has seen the project. It stops a passer-
# by and a casual scan of the venue network; it does not stop someone who knows
# what this box is. If yours is on a network you do not control, or the event
# matters, change it here and restart:
#
#   sudo systemctl restart fpvlink
#
# Blank it entirely and the dashboard is open to anyone who can reach the port.
# The service starts either way — a password problem never stops the box putting
# video on HDMI.
#
# Requests from 127.0.0.1 skip the password whatever this is set to, so
# scripts/capture-flag.py and collect-diagnostics.sh keep working on the box.
FPVLINK_PASSWORD=fpvlink12345

# Signs the session cookie. Optional, only meaningful if a password is set.
#
# Leave blank and one is generated at startup, which works fine except that
# every restart signs everyone out — including the phone in your pocket when
# the box reboots between races. Set a fixed value and logins survive restarts.
#
# Generate one with:  openssl rand -base64 48
FPVLINK_SESSION_SECRET=


# ─── Logging ─────────────────────────────────────────────────────────────────

# Application log verbosity. Overrides config.json logging.level.
# Options: error | warn | info | debug
# 'debug' also enables verbose GStreamer element logging (GST_DEBUG=4).
LOG_LEVEL=info

# GStreamer debug categories and levels.
# Format: category:level,category:level  (or just a global level 0–9)
# Examples:
#   GST_DEBUG=2                         (global warnings)
#   GST_DEBUG=mppvideodec:5,srtsink:4   (per-element debugging)
# This is set by the [Service] section in the unit file and can be overridden here.
# GST_DEBUG=2


# ─── Python capture layer ────────────────────────────────────────────────────

# Override the USB Vendor ID used by the capture layer.
# Default matches DJI devices. Change only if using compatible third-party hardware.
# USB_VID=0x2CA3

# Override the USB Product ID. 'auto' tries all known DJI PIDs.
# USB_PID=auto

# Python log level for the capture subprocess.
# Options: DEBUG | INFO | WARNING | ERROR
PYTHON_LOG_LEVEL=INFO


# ─── Recording ────────────────────────────────────────────────────────────────

# Override the recording path from config.json.
# The directory must exist and be writable by the fpvlink user.
# RECORD_PATH=/record


# ─── Advanced / developer ────────────────────────────────────────────────────

# Set to '1' to enable Node.js --inspect debugger (port 9229).
# WARNING: Never enable in production — the debugger port has no authentication.
# NODE_INSPECT=0

# Path to the GStreamer plugin scanner binary.
# Usually auto-detected; set explicitly only if using a custom GStreamer build.
# GST_PLUGIN_SCANNER=/usr/lib/aarch64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner

# Additional GStreamer plugin search paths (colon-separated).
# GST_PLUGIN_PATH=/opt/fpvlink/gst-plugins
